<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No Java/Kotlin code in this app: android:hasCode="false" and the
         activity is android.app.NativeActivity, implemented entirely in C++
         (app/src/main/cpp/native_main.cpp via android_native_app_glue). -->
    <application
        android:hasCode="false"
        android:icon="@drawable/ic_launcher"
        android:label="MobileDAW Native"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:label="MobileDAW Native"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="mobiledaw_native" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
